DATABASE_URL=postgres://auth:auth@localhost:5432/auth
VALKEY_URL=redis://localhost:6379
# 48 random bytes, base64. Encrypts per-instance signing keys at rest.
# Generate: openssl rand -base64 48
MASTER_KEY=
# Optional but recommended: pin the email blind-index key so MASTER_KEY can be rotated. Run `npm run keys:print-index-key`.
INDEX_KEY=
# Public origin of this service (used as JWT issuer)
APP_URL=http://localhost:3000

# --- Production (e.g. DigitalOcean App Platform); all optional locally ---
# Postgres CA certificate (PEM). DigitalOcean: Databases > your cluster > Download CA certificate.
# "\n" escapes are accepted so it can live on one line.
DATABASE_CA_CERT=
# Production Valkey must use TLS: rediss://default:<password>@host:25061
# Trusted reverse-proxy hops (default 1 in production). Client IP = Nth-from-right X-Forwarded-For entry. 0 = trust none.
TRUST_PROXY_HOPS=1
# Production-only (required when NODE_ENV=production):
MAIL_TRANSPORT=dev
RESEND_API_KEY=
MAIL_FROM=Daywalker Auth <no-reply@users.daywalker.dev>
# Optional: Twilio Verify for SMS two-factor (all three, or none)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Cloudflare Turnstile on the dashboard's own sign-in, sign-up and password reset pages.
# On only when TURNSTILE_SECRET is set. Keep the secret in your secret manager, never in git.
# TURNSTILE_HOSTNAMES: hostnames the widget may be solved on (default: hostname of APP_URL);
# never list localhost or 127.0.0.1 in production.
TURNSTILE_SITE_KEY=0x4AAAAAAFjRgGz7X9Ig6AM3
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=
# Domain passkeys bind to (default: hostname of APP_URL). Decide before launch.
PASSKEY_RP_ID=

# Webhook delivery loop runs inside the server; set to 0 to disable on this instance
# WEBHOOK_WORKER=1

# Developer dashboard (/dashboard). Run `npm run bootstrap:platform` once, then paste the printed key here.
# PLATFORM_PUBLISHABLE_KEY=pk_live_...
