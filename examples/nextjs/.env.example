# From your instance in the dashboard: Overview > Connection details (add http://localhost:3001 to Allowed origins)
NEXT_PUBLIC_DAYWALKER_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_DAYWALKER_AUTH_URL=http://localhost:3000
# Server only. Never prefix with NEXT_PUBLIC_.
DAYWALKER_SECRET_KEY=sk_test_...
# Optional: reject tokens minted for other apps on the same instance
DAYWALKER_AUTHORIZED_PARTIES=http://localhost:3001
# Optional: verified Account Portal custom domain (dashboard > Configure > Account Portal > Customization)
# NEXT_PUBLIC_DAYWALKER_HOSTED_DOMAIN=accounts.example.com
