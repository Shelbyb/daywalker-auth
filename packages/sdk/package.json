{
  "name": "@daywalker/auth",
  "version": "0.1.0",
  "description": "SDK for Daywalker Auth: browser client, React components, server verification and Next.js helpers",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/core/index.ts",
    "./react": "./src/react/index.tsx",
    "./server": "./src/server/index.ts",
    "./nextjs": "./src/nextjs/index.ts",
    "./styles.css": "./src/react/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "jose": "^6.2.13"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
